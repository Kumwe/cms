APP_ENV=development
APP_DEBUG=true
# Direct PHP processes use APP_BASE_URL. Development Compose derives the same
# value from KUMWE_HTTP_HOST and KUMWE_HTTP_PORT below.
APP_BASE_URL=http://localhost:8080
KUMWE_HTTP_HOST=localhost
KUMWE_HTTP_BIND=127.0.0.1
# Change this one value to publish development on another host port.
KUMWE_HTTP_PORT=8080
APP_PUBLIC_SITE=default
APP_TRUSTED_HOSTS=localhost,127.0.0.1
APP_TRUSTED_PROXIES=
APP_MAX_BODY_BYTES=2097152
APP_ADMIN_SESSION_SECONDS=28800
# How long a caller-minted Idempotency-Key replays the outcome of the command it was first used
# for, and how long the claim is then remembered so a later repeat is refused by name rather than
# applied a second time. Retention must outlast replay. Replay is one hour to ninety days;
# retention is at most one year. Lengthen replay for clients that capture work while disconnected.
BUSINESS_IDEMPOTENCY_REPLAY_SECONDS=604800
BUSINESS_IDEMPOTENCY_RETENTION_SECONDS=2592000
# These independent first-install choices are persisted when profiles are first reconciled.
# Use KUMWE_SITE_CONTENT_PROFILE=blank and KUMWE_BUSINESS_DEMO=false for an empty site.
# KUMWE_BUSINESS_PROFILE names any discovered business dataset directly (for example vdm or
# none) and wins over the boolean KUMWE_BUSINESS_DEMO alias when set.
KUMWE_SITE_CONTENT_PROFILE=documentation
KUMWE_BUSINESS_DEMO=true
KUMWE_RELEASE=2.0.0-dev
# Where browsers load the pinned Studio page-builder module and enhancement runtime from, in the npm
# package layout. The public registry CDN is the default; point it at an exact HTTPS mirror or a
# site-absolute path such as /vendor/npm for air-gapped deployments.
KUMWE_STUDIO_BROWSER_BASE_URL=https://cdn.jsdelivr.net/npm
APP_SECRET=change-this-to-at-least-32-random-bytes
EXTENSION_RUNTIME_SIGNING_KEY_ID=runtime-v1
EXTENSION_RUNTIME_SIGNING_KEY=use-a-different-32-byte-random-runtime-secret
EXTENSION_RUNTIME_PREVIOUS_KEYS=
# Or set EXTENSION_RUNTIME_PREVIOUS_KEYS_FILE to an absolute root-readable JSON secret file.
# Business-record secret fields are sealed with their own key, so APP_SECRET can be rotated on its
# own. Leave these unset to keep the APP_SECRET-derived application-secret-v1 key active, which is
# what an existing installation already runs on. Each also accepts a _FILE companion.
RECORD_ENCRYPTION_KEY=
RECORD_ENCRYPTION_KEY_ID=
RECORD_ENCRYPTION_PREVIOUS_KEYS=
# Set RECORD_ENCRYPTION_LEGACY_SECRET to the outgoing APP_SECRET before rotating it, so envelopes
# still carrying application-secret-v1 keep opening until business-record-rekey has moved them.
RECORD_ENCRYPTION_LEGACY_SECRET=
KUMWE_DEPLOYMENT_ID=local-development
KUMWE_REPLICA_ID=local-replica
KUMWE_PROCESS_ID=development-process
KUMWE_INSTANCE_ID=development-instance
# Development and testing only. A process started with APP_ENV=production and this set to true refuses
# to boot, because it turns off Ed25519 package-signature verification for every install.
EXTENSIONS_ALLOW_UNSIGNED_LOCAL=true
# Whether install-time admission also collects advisory authoring checks: scan (default) or off.
# Mandatory archive, manifest, PHP syntax/reference and attestation checks always run. Production refuses off.
# The earlier enforce and warn spellings are still accepted and select scan.
EXTENSIONS_CONFORMANCE_ADMISSION=scan
# Upstream signing-key revocation feed. Set both, or neither. The verification key is pinned here rather
# than kept in the trust store, because the store is what the feed revokes.
EXTENSIONS_REVOCATION_FEED_URL=
EXTENSIONS_REVOCATION_FEED_KEY=
EXTENSIONS_REVOCATION_FEED_MAX_STALE_SECONDS=172800

DB_DRIVER=mariadb
DB_HOST=database
DB_PORT=3306
DB_NAME=kumwe
DB_USER=kumwe
DB_PASSWORD=kumwe-development-only
DB_TABLE_PREFIX=kumwe_
DB_SSLMODE=disable
DB_SERVER_VERSION=mariadb-12.3.2
KUMWE_DATABASE_IMAGE=mariadb:lts

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_NAMESPACE=kumwe.app
KUMWE_REDIS_IMAGE=redis:8-alpine
