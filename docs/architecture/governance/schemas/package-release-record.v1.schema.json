{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kumwe.dev/schemas/package-release-record.v1",
  "title": "Kumwe package release contract record",
  "description": "Production package contract and qualification requirements. Publication observations belong in independent release attestations.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "kumwe-package-release-record/v1"
    },
    "artifact_kind": {
      "$ref": "#/$defs/artifact_kind"
    },
    "migration_id": {
      "$ref": "#/$defs/migration_id"
    },
    "change_set": {
      "$ref": "#/$defs/change_set_id"
    },
    "source": {
      "type": "object",
      "properties": {
        "app": {
          "type": "object",
          "properties": {
            "repository": {
              "$ref": "#/$defs/url"
            },
            "baseline_commit": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/commit"
                }
              ]
            },
            "examined_paths": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/path"
              }
            },
            "old_namespace_roots": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/namespace_root"
              }
            },
            "capability_index_sha256": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/sha256"
                }
              ]
            }
          },
          "required": [
            "repository",
            "baseline_commit",
            "examined_paths",
            "old_namespace_roots",
            "capability_index_sha256"
          ],
          "additionalProperties": false
        },
        "semantic_inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "version_or_commit": {
                "type": "string",
                "minLength": 1
              },
              "manifest_or_corpus": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            },
            "required": [
              "owner",
              "version_or_commit",
              "manifest_or_corpus",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "examined_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "app",
        "semantic_inputs",
        "examined_dependencies"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "repository": {
          "$ref": "#/$defs/url"
        },
        "artifact_identity": {
          "type": "string",
          "minLength": 1
        },
        "canonical_namespace_or_abi": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repository",
        "artifact_identity",
        "canonical_namespace_or_abi"
      ],
      "additionalProperties": false
    },
    "ownership": {
      "type": "object",
      "properties": {
        "responsibility": {
          "type": "string",
          "minLength": 1
        },
        "non_responsibilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_dependency_ceiling": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "implementation_owner": {
          "type": "string",
          "minLength": 1
        },
        "next_consumer": {
          "type": "string",
          "minLength": 1
        },
        "public_manifests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/manifest_digest"
          }
        },
        "intentionally_excluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "responsibility",
        "non_responsibilities",
        "allowed_dependency_ceiling",
        "implementation_owner",
        "next_consumer",
        "public_manifests",
        "intentionally_excluded"
      ],
      "additionalProperties": false
    },
    "framework_php": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/framework_php"
        }
      ]
    },
    "native_cpp": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/native_cpp"
        }
      ]
    },
    "php_extension": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/php_extension"
        }
      ]
    },
    "tests": {
      "type": "object",
      "properties": {
        "moved_or_added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remain_in_app_or_consumer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "split_tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prohibited_duplicates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "corpora": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "moved_or_added",
        "remain_in_app_or_consumer",
        "split_tests",
        "prohibited_duplicates",
        "corpora"
      ],
      "additionalProperties": false
    },
    "documentation": {
      "type": "object",
      "properties": {
        "charter": {
          "$ref": "#/$defs/path"
        },
        "readme": {
          "$ref": "#/$defs/path"
        },
        "public_api": {
          "$ref": "#/$defs/path"
        },
        "architecture": {
          "$ref": "#/$defs/path"
        },
        "integration_or_consumer": {
          "$ref": "#/$defs/path"
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "changelog_record": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "charter",
        "readme",
        "public_api",
        "architecture",
        "integration_or_consumer",
        "examples",
        "changelog_record"
      ],
      "additionalProperties": false
    },
    "release_expectations": {
      "type": "object",
      "properties": {
        "version_policy": {
          "type": "string",
          "minLength": 1
        },
        "expected_artifact_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_registry_or_installer": {
          "type": [
            "string",
            "null"
          ]
        },
        "required_external_attestation": {
          "type": "boolean"
        }
      },
      "required": [
        "version_policy",
        "expected_artifact_types",
        "required_checks",
        "required_registry_or_installer",
        "required_external_attestation"
      ],
      "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "properties": {
        "completion_claim": {
          "const": false
        }
      },
      "required": [
        "completion_claim"
      ],
      "additionalProperties": false
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consumer_contract": {
      "type": "object",
      "properties": {
        "permitted_only_when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "consumer_repository": {
          "type": "string",
          "minLength": 1
        },
        "dependency_or_native_change": {
          "type": "string",
          "minLength": 1
        },
        "namespace_or_api_replacements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files_to_update": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files_to_remove": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tests_to_remove": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tests_to_retain_or_add": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "di_or_provisioning_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capability_index_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changelog_and_evidence_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification_commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "permitted_only_when",
        "consumer_repository",
        "dependency_or_native_change",
        "namespace_or_api_replacements",
        "files_to_update",
        "files_to_remove",
        "tests_to_remove",
        "tests_to_retain_or_add",
        "di_or_provisioning_changes",
        "capability_index_changes",
        "changelog_and_evidence_changes",
        "verification_commands"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "artifact_kind",
    "migration_id",
    "change_set",
    "source",
    "target",
    "ownership",
    "framework_php",
    "native_cpp",
    "php_extension",
    "tests",
    "documentation",
    "release_expectations",
    "consumer_contract",
    "governance",
    "decisions",
    "blockers"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "artifact_kind": {
          "const": "framework_php"
        },
        "framework_php": {
          "type": "object"
        },
        "native_cpp": {
          "type": "null"
        },
        "php_extension": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "artifact_kind": {
          "const": "native_cpp"
        },
        "framework_php": {
          "type": "null"
        },
        "native_cpp": {
          "type": "object"
        },
        "php_extension": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "artifact_kind": {
          "const": "php_extension"
        },
        "framework_php": {
          "type": "null"
        },
        "native_cpp": {
          "type": "null"
        },
        "php_extension": {
          "type": "object"
        }
      }
    }
  ],
  "$defs": {
    "artifact_kind": {
      "type": "string",
      "enum": [
        "framework_php",
        "native_cpp",
        "php_extension"
      ]
    },
    "change_set_id": {
      "type": "string",
      "pattern": "^KUMWE-CS-[0-9]{4}-[0-9]{3}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$",
      "description": "Full 40-character Git commit SHA."
    },
    "fqcn": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\\\[A-Za-z_][A-Za-z0-9_]*)*$",
      "description": "Fully qualified class-like name without a leading backslash."
    },
    "framework_php": {
      "type": "object",
      "properties": {
        "composer_package": {
          "$ref": "#/$defs/package"
        },
        "canonical_namespace": {
          "$ref": "#/$defs/namespace"
        },
        "public_api_manifest": {
          "$ref": "#/$defs/path"
        },
        "capability_manifest": {
          "$ref": "#/$defs/path"
        },
        "service_map": {
          "$ref": "#/$defs/path"
        },
        "extracted_symbols": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "old_fqcn": {
                "$ref": "#/$defs/fqcn"
              },
              "new_fqcn": {
                "$ref": "#/$defs/fqcn"
              },
              "source_path": {
                "$ref": "#/$defs/path"
              },
              "target_path": {
                "$ref": "#/$defs/path"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "class",
                  "interface",
                  "trait",
                  "enum",
                  "function"
                ]
              },
              "public_methods": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "public_properties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "public_constants": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "exceptions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "serialization_contract": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "compatibility": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "old_fqcn",
              "new_fqcn",
              "source_path",
              "target_path",
              "kind",
              "public_methods",
              "public_properties",
              "public_constants",
              "exceptions",
              "serialization_contract",
              "compatibility"
            ],
            "additionalProperties": false
          }
        },
        "consumers": {
          "type": "object",
          "properties": {
            "app_code": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "configuration_and_di": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reflection_and_string_references": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "fixtures_and_examples": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "external": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "app_code",
            "configuration_and_di",
            "reflection_and_string_references",
            "fixtures_and_examples",
            "external"
          ],
          "additionalProperties": false
        },
        "dependency_injection": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "direct",
                "config-provider"
              ]
            },
            "provider": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/fqcn"
                }
              ]
            },
            "factories": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "aliases": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "service_lifetimes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "configuration_keys": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "provider_absence_reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "mode",
            "provider",
            "factories",
            "aliases",
            "service_lifetimes",
            "configuration_keys",
            "provider_absence_reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "composer_package",
        "canonical_namespace",
        "public_api_manifest",
        "capability_manifest",
        "service_map",
        "extracted_symbols",
        "consumers",
        "dependency_injection"
      ],
      "additionalProperties": false
    },
    "manifest_digest": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "migration_id": {
      "type": "string",
      "pattern": "^KUMWE-MIG-[0-9]{4}-[0-9]{3}$"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\\\[A-Za-z_][A-Za-z0-9_]*)*\\\\?$",
      "description": "Namespace with or without a trailing backslash."
    },
    "namespace_root": {
      "type": "string",
      "pattern": "^([A-Za-z_][A-Za-z0-9_]*\\\\)+$",
      "description": "Namespace root with a trailing backslash (autoload.psr-4)."
    },
    "native_cpp": {
      "type": "object",
      "properties": {
        "cpp_namespace": {
          "type": "string",
          "minLength": 1
        },
        "cmake_targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "public_headers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cpp_api": {
          "type": "object",
          "properties": {
            "classes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "functions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "classes",
            "functions"
          ],
          "additionalProperties": false
        },
        "c_abi": {
          "type": "object",
          "properties": {
            "major": {
              "type": "integer",
              "minimum": 1
            },
            "symbol_prefix": {
              "type": "string",
              "minLength": 1
            },
            "headers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "functions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "structs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "enums_and_codes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "opaque_handles": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "create_functions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "use_functions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "release_function": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ownership": {
                    "type": "string",
                    "minLength": 1
                  },
                  "thread_safety": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "name",
                  "create_functions",
                  "use_functions",
                  "release_function",
                  "ownership",
                  "thread_safety"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "major",
            "symbol_prefix",
            "headers",
            "functions",
            "structs",
            "enums_and_codes",
            "opaque_handles"
          ],
          "additionalProperties": false
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "corpora": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "profile": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            },
            "required": [
              "owner",
              "version",
              "profile",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "limits_and_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidate_cross_build_expectations": {
          "type": "object",
          "properties": {
            "source_archive_recipe": {
              "type": "string",
              "minLength": 1
            },
            "network_free_build": {
              "type": "boolean"
            },
            "required_extension_smoke_surface": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required_platform_and_php_matrix": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required_abi_capability_corpus_checks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "attestation_schema": {
              "const": "kumwe-engine-candidate-attestation/v1"
            },
            "attestation_storage": {
              "type": "string",
              "minLength": 1
            },
            "publishing_permitted": {
              "type": "boolean"
            }
          },
          "required": [
            "source_archive_recipe",
            "network_free_build",
            "required_extension_smoke_surface",
            "required_platform_and_php_matrix",
            "required_abi_capability_corpus_checks",
            "attestation_schema",
            "attestation_storage",
            "publishing_permitted"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "cpp_namespace",
        "cmake_targets",
        "public_headers",
        "cpp_api",
        "c_abi",
        "capabilities",
        "corpora",
        "limits_and_errors",
        "candidate_cross_build_expectations"
      ],
      "additionalProperties": false
    },
    "nrm_id": {
      "type": "string",
      "pattern": "^NRM-[0-9]{4}-[0-9]{3}$"
    },
    "package": {
      "type": "string",
      "pattern": "^kumwe/[a-z0-9-]+$",
      "description": "Composer package name in the kumwe vendor."
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "Relative path with forward slashes."
    },
    "php_extension": {
      "type": "object",
      "properties": {
        "repository_package": {
          "$ref": "#/$defs/package"
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "platform_package": {
          "type": "string",
          "pattern": "^ext-[a-z0-9_]+$"
        },
        "php_namespace": {
