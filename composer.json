{
  "name": "kumwe/app",
  "type": "project",
  "description": "Kumwe App 2.0",
  "keywords": [
    "cms",
    "kumwe",
    "laminas",
    "mezzio"
  ],
  "homepage": "https://github.com/kumwe/app",
  "authors": [
    {
      "name": "Kumwe",
      "homepage": "https://github.com/kumwe"
    }
  ],
  "support": {
    "issues": "https://github.com/kumwe/app/issues",
    "source": "https://github.com/kumwe/app",
    "docs": "https://github.com/kumwe/app/blob/master/README.md"
  },
  "license": "Apache-2.0",
  "require": {
    "php": "^8.5",
    "ext-ctype": "*",
    "ext-fileinfo": "*",
    "ext-filter": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-redis": "*",
    "ext-sodium": "*",
    "ext-zip": "*",
    "doctrine/dbal": "^4.4",
    "kumwe/canonical-json": "0.1.1",
    "kumwe/conversion": "0.1.2",
    "kumwe/extension-sdk": "0.2.4",
    "kumwe/producer": "0.3.0 as 0.2.99",
    "laminas/laminas-authentication": "^2.19",
    "laminas/laminas-diactoros": "^3.8",
    "laminas/laminas-eventmanager": "^3.15",
    "laminas/laminas-httphandlerrunner": "^2.13",
    "laminas/laminas-servicemanager": "^4.5",
    "mcp/sdk": "^0.7.0",
    "mezzio/mezzio": "^3.28",
    "mezzio/mezzio-fastroute": "^3.14",
    "mezzio/mezzio-helpers": "^5.20",
    "mezzio/mezzio-problem-details": "^1.19",
    "mezzio/mezzio-twigrenderer": "^2.19",
    "monolog/monolog": "^3.9",
    "psr/clock": "^1.0",
    "psr/log": "^3.0",
    "ramsey/uuid": "^4.9",
    "twig/twig": "^3.26"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^13.3",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "suggest": {
    "ext-pdo_mysql": "Required when Kumwe uses MariaDB or MySQL.",
    "ext-pdo_pgsql": "Required when Kumwe uses PostgreSQL."
  },
  "autoload": {
    "psr-4": {
      "Kumwe\\App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kumwe\\App\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    },
    "audit": {
      "abandoned": "fail"
    },
    "optimize-autoloader": true,
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true,
    "process-timeout": 3600
  },
  "scripts": {
    "analyse": "phpstan analyse --no-progress --memory-limit=1G",
    "security:audit": "composer audit --locked --abandoned=fail",
    "security:secrets": "bash tools/scan-secrets.sh",
    "cs": "phpcs -q",
    "baseline:record": "php tools/record-baseline.php --emit --write --commit=$(git rev-parse HEAD) --recorded-at=$(date -u +%F)",
    "baseline:check": "php tools/record-baseline.php --check",
    "docs:api": "php tools/verify-docblocks.php src",
    "docs:tests": "php tools/verify-docblocks.php --baseline=docs/quality/test-docblock-baseline.json tests",
    "docs:format": "php tools/format-docblocks.php src",
    "docs:format:check": "php tools/format-docblocks.php --dry-run src",
    "extension:contract": "php tools/verify-extension-contract.php",
    "extension:independence": "php tools/verify-author-package-independence.php",
    "conversion:api": "php tools/verify-conversion-api.php",
    "cli:contract": "php tools/verify-cli-machine-contract.php",
    "mcp:contract": "php tools/generate-mcp-machine-contract.php --check",
    "studio:corpus": "php tools/verify-studio-corpus.php",
    "studio:dependencies": "php tools/verify-studio-dependencies.php",
    "kumwe:capability-index": "php tools/generate-capability-index.php --write",
    "kumwe:capability-index-check": "php tools/generate-capability-index.php --check",
    "kumwe:core-growth-check": "php tools/verify-core-growth.php",
    "kumwe:core-growth-record": "php tools/verify-core-growth.php --record",
    "interface:programme": "php tools/verify-interface-programme.php",
    "roadmap:check": "php tools/verify-roadmap.php",
    "openapi:compile": "php tools/compile-openapi.php",
    "openapi:accept-generation": "php tools/compile-openapi.php --accept-generation",
    "openapi:check": "php tools/compile-openapi.php --check",
    "translation:compile": "php tools/compile-catalogues.php",
    "translation:check": "php tools/compile-catalogues.php --check",
    "translation:strings": "php tools/verify-translated-strings.php",
    "assets:direction": "php tools/verify-stylesheet-direction.php",
    "cs:fix": "phpcbf",
    "architecture:policy": "bash tools/verify-policy.sh",
    "architecture:boundaries": "php tools/verify-package-boundaries.php",
    "architecture:dependencies": "php tools/verify-dependency-graph.php",
    "quality:contract": "php tools/quality-contract.php --check",
    "quality:run": "php tools/quality-contract.php --run",
    "coverage:attribution": "php tools/coverage-contract.php --attribution",
    "coverage:ratchet": "php tools/coverage-contract.php --ratchet",
    "perf:plan": "php tools/perf-harness.php --plan",
    "perf:run": "php tools/perf-harness.php --run",
    "perf:breakpoint": "php tools/perf-harness.php --breakpoint",
    "test": "phpunit --colors=always",
    "test:artifact": "bash tools/deployed-artifact-lane.sh",
    "test:idempotency": "php tools/verify-suite-idempotency.php",
    "test:integration": "phpunit --testsuite integration --colors=always",
    "test:unit": "phpunit --testsuite unit --colors=always",
    "qa": [
      "@architecture:policy",
      "@baseline:check",
      "@quality:contract",
      "@docs:api",
      "@docs:format:check",
      "@docs:tests",
      "@extension:contract",
      "@extension:independence",
      "@conversion:api",
      "@cli:contract",
      "@mcp:contract",
      "@studio:corpus",
      "@studio:dependencies",
      "@kumwe:capability-index-check",
      "@kumwe:core-growth-check",
      "@interface:programme",
      "@roadmap:check",
      "@openapi:check",
      "@translation:check",
      "@translation:strings",
      "@assets:direction",
      "@coverage:attribution",
      "@cs",
      "@analyse",
      "@test"
    ],
    "post-create-project-cmd": "@php bin/kumwe-install"
  },
  "archive": {
    "exclude": [
      "/.github",
      "/.gitattributes",
      "/.gitignore",
      "/.gitleaks.toml",
      "/.phpunit.cache",
      "/build",
      "/compose.yaml",
      "/docker",
      "/phpcs.xml",
      "/phpstan.neon",
      "/phpunit.xml.dist",
      "/tests"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
